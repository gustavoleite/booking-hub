<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Javadoc is not required for internal application code (course project) -->
  <suppress checks="MissingJavadocType" files=".*\.java"/>
  <suppress checks="MissingJavadocMethod" files=".*\.java"/>

  <!-- RabbitMQ is a product name acronym — renaming would break Spring SpEL bean references -->
  <suppress checks="AbbreviationAsWordInName" files="RabbitMQConfig\.java"/>

  <!-- GraphQL is a product name acronym — renaming would misrepresent the technology -->
  <suppress checks="AbbreviationAsWordInName" files="GraphQLErrorConfig\.java"/>

  <!-- Code uses 4-space indentation (OpenRewrite style); google_checks expects 2-space -->
  <suppress checks="Indentation" files=".*\.java"/>
</suppressions>
