        {
          "name": "Erros - Slot Já Ocupado",
          "item": [
            {
              "name": "[ERRO 409] Double Booking",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"professionalId\": \"{{professional_id}}\",\n  \"establishmentId\": \"{{establishment_id}}\",\n  \"providedServiceId\": \"{{service_id}}\",\n  \"startDatetime\": \"{{booking_datetime}}\",\n  \"notes\": \"Tentativa duplicada\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/bookings",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings"]
                }
              }
            },
            {
              "name": "[ERRO 422] Cancelar Agendamento Já Finalizado",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
