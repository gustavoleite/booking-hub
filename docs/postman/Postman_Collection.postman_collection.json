    {
      "name": "4. Catalog Service - Afiliações",
      "item": [
        {
          "name": "Vincular Profissional ao Estabelecimento (Upsert)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true,\n  \"workSchedules\": [\n    { \"dayOfWeek\": 1, \"startTime\": \"09:00:00\", \"endTime\": \"18:00:00\" },\n    { \"dayOfWeek\": 2, \"startTime\": \"09:00:00\", \"endTime\": \"18:00:00\" },\n    { \"dayOfWeek\": 3, \"startTime\": \"09:00:00\", \"endTime\": \"18:00:00\" },\n    { \"dayOfWeek\": 4, \"startTime\": \"09:00:00\", \"endTime\": \"18:00:00\" },\n    { \"dayOfWeek\": 5, \"startTime\": \"09:00:00\", \"endTime\": \"18:00:00\" }\n  ],\n  \"serviceOfferings\": [\n    {\n      \"providedServiceId\": \"{{service_id}}\",\n      \"price\": 120.00,\n      \"durationMinutes\": 60\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/catalog/establishments/{{establishment_id}}/affiliations?professionalId={{professional_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "catalog", "establishments", "{{establishment_id}}", "affiliations"],
              "query": [{ "key": "professionalId", "value": "{{professional_id}}" }]
            }
          }
        },
        {
          "name": "Consultar Agenda do Profissional (Público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/catalog/establishments/{{establishment_id}}/affiliations/professional/{{professional_id}}/schedule?serviceId={{service_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "catalog", "establishments", "{{establishment_id}}", "affiliations", "professional", "{{professional_id}}", "schedule"],
              "query": [{ "key": "serviceId", "value": "{{service_id}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "5. Booking Service - Disponibilidade",
      "item": [
        {
          "name": "Consultar Slots Disponíveis (Público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings/availability?establishmentId={{establishment_id}}&professionalId={{professional_id}}&serviceId={{service_id}}&date={{availability_date}}",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "availability"],
              "query": [
                { "key": "establishmentId", "value": "{{establishment_id}}" },
                { "key": "professionalId", "value": "{{professional_id}}" },
                { "key": "serviceId", "value": "{{service_id}}" },
                { "key": "date", "value": "{{availability_date}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Booking Service - Agendamentos",
      "item": [
        {
          "name": "Criar Agendamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set('booking_id', jsonData.id);",
                  "    console.log('booking_id salvo: ' + jsonData.id);",
