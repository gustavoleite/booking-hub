{
  "info": {
    "name": "Beauty & Wellness API",
    "description": "Coleção de testes para os microsserviços do sistema de agendamento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item":[
    {
      "name": "1. Auth Service",
      "item":[
        {
          "name": "Registrar Usuário",
          "request": {
            "method": "POST",
            "header":[
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@teste.com\",\n  \"password\": \"SenhaForte123!\",\n  \"role\": \"ROLE_CLIENT\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path":["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Gera JWT)",
          "event":[
            {
              "listen": "test",
              "script": {
                "exec":[
                  "var jsonData = pm.response.json();",
                  "if(jsonData.accessToken) {",
                  "    pm.environment.set(\"access_token\", jsonData.accessToken);",
                  "    console.log(\"Token salvo na variável de ambiente!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header":[
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@teste.com\",\n  \"password\": \"SenhaForte123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path":["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Falhas de Validação (Testes HTTP)",
          "item": [
            {
              "name": "[ERRO 409] Registrar E-mail Duplicado",
              "request": {
                "method": "POST",
                "header":[{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"cliente@teste.com\",\n  \"password\": \"SenhaForte123!\",\n  \"role\": \"ROLE_CLIENT\"\n}"
                },
                "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path":["api", "auth", "register"] }
              }
            },
            {
              "name": "[ERRO 400] Registrar com Senha Fraca",
              "request": {
                "method": "POST",
                "header":[{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"novo@teste.com\",\n  \"password\": \"12345\",\n  \"role\": \"ROLE_CLIENT\"\n}"
                },
                "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Catalog Service",
      "item": [
        {
          "name": "Profissionais",
          "item": [
            {
              "name": "Meu Perfil Profissional",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/catalog/professionals/me",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "professionals", "me"]
                }
              }
            },
            {
              "name": "Criar/Atualizar Meu Perfil",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"João Barbeiro\",\n  \"bio\": \"Especialista em cortes clássicos e barba.\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\",\n  \"specialties\": [\"Corte Masculino\", \"Barba\"]\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/catalog/professionals/me",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "professionals", "me"]
                }
              }
            },
            {
              "name": "Obter Perfil por ID",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/catalog/professionals/:id",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "professionals", ":id"],
                  "variable": [
                    { "key": "id", "value": "{{professional_id}}" }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Estabelecimentos",
          "item": [
            {
              "name": "Criar Novo Estabelecimento",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Barbearia Central\",\n  \"cnpj\": \"12.345.678/0001-90\",\n  \"description\": \"O melhor corte da cidade.\",\n  \"address\": {\n    \"street\": \"Rua Principal\",\n    \"number\": \"100\",\n    \"city\": \"São Paulo\",\n    \"state\": \"SP\",\n    \"zipCode\": \"01234-567\"\n  },\n  \"businessHours\": [\n    {\n      \"dayOfWeek\": 1,\n      \"openTime\": { \"hour\": 8, \"minute\": 0 },\n      \"closeTime\": { \"hour\": 18, \"minute\": 0 }\n    }\n  ],\n  \"services\": [\n    {\n      \"title\": \"Corte Simples\",\n      \"description\": \"Corte de cabelo com máquina ou tesoura.\"\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/catalog/establishments",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "establishments"]
                }
              }
            },
            {
              "name": "Listar Meus Estabelecimentos",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/catalog/establishments/my-salons",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "establishments", "my-salons"]
                }
              }
            },
            {
              "name": "Obter Detalhes do Estabelecimento",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/catalog/establishments/:id",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "establishments", ":id"],
                  "variable": [
                    { "key": "id", "value": "{{establishment_id}}" }
                  ]
                }
              }
            },
            {
              "name": "Atualizar Estabelecimento",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Barbearia Central Atualizada\",\n  \"cnpj\": \"12.345.678/0001-90\",\n  \"description\": \"Nova descrição.\",\n  \"address\": {\n    \"street\": \"Nova Rua\",\n    \"number\": \"200\",\n    \"city\": \"São Paulo\",\n    \"state\": \"SP\",\n    \"zipCode\": \"01234-567\"\n  }\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/catalog/establishments/:id",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "establishments", ":id"],
                  "variable": [
                    { "key": "id", "value": "{{establishment_id}}" }
                  ]
                }
              }
            },
            {
              "name": "Inativar Estabelecimento",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/catalog/establishments/:id",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "establishments", ":id"],
                  "variable": [
                    { "key": "id", "value": "{{establishment_id}}" }
                  ]
                }
              }
            },
            {
              "name": "Adicionar Serviço ao Estabelecimento",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Barba Completa\",\n  \"description\": \"Barba com toalha quente e navalha.\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/catalog/establishments/:id/services",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "establishments", ":id", "services"],
                  "variable": [
                    { "key": "id", "value": "{{establishment_id}}" }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Afiliações",
          "item": [
            {
              "name": "Vincular Profissional a Estabelecimento",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-User-Id", "value": "{{x_user_id}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"professionalId\": \"{{professional_id}}\",\n  \"serviceOfferings\": [\n    {\n      \"providedServiceId\": \"UUID_DO_SERVICO\",\n      \"price\": 50.0,\n      \"durationMinutes\": 30\n    }\n  ],\n  \"workSchedules\": [\n    {\n      \"dayOfWeek\": 1,\n      \"startTime\": { \"hour\": 9, \"minute\": 0 },\n      \"endTime\": { \"hour\": 17, \"minute\": 0 }\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/catalog/establishments/:establishmentId/affiliations",
                  "host": ["{{base_url}}"],
                  "path": ["api", "catalog", "establishments", ":establishmentId", "affiliations"],
                  "variable": [
                    { "key": "establishmentId", "value": "{{establishment_id}}" }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer":[
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  }
}
