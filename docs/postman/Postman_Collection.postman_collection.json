              "mode": "raw",
              "raw": "{\n  \"professionalId\": \"{{professional_id}}\",\n  \"establishmentId\": \"{{establishment_id}}\",\n  \"providedServiceId\": \"{{service_id}}\",\n  \"startDatetime\": \"{{booking_datetime}}\",\n  \"notes\": \"Prefiro corte mais curto nas laterais\"\n}"
